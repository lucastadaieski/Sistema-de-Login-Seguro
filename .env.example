# Copie este arquivo para ".env" (na mesma pasta) e preencha os valores.
# O arquivo .env está no .gitignore: suas senhas nunca vão para o GitHub.

# String de conexão do MongoDB Atlas (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://USUARIO:SENHA@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DATABASE=loginseguro

# Administrador criado automaticamente na primeira execução
ADMIN_EMAIL=admin@loginseguro.com
ADMIN_PASSWORD=Troque@Esta1Senha

# Chave secreta dos tokens JWT (mínimo 32 caracteres).
# Precisa ser IGUAL à JWT_SECRET do ThinDesk.
JWT_SECRET=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres

# Opcionais
# TEMA_PADRAO=claro
# SESSION_TIMEOUT=30m
# COOKIE_SECURE=true
